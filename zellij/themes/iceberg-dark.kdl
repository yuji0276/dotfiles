// WezTerm の組み込みスキーム iceberg-dark と同一のパレット
// (wezterm.color.get_builtin_schemes() から取得した値をそのまま使用)
themes {
    iceberg-dark {
        bg "#161821"
        fg "#c6c8d1"
        black "#1e2132"
        red "#e27878"
        green "#b4be82"
        yellow "#e2a478"
        blue "#84a0c6"
        magenta "#a093c7"
        cyan "#89b8c2"
        white "#c6c8d1"
        orange "#e9b189"
    }
}
